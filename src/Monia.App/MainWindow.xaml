<Window x:Class="Monia.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Monia.App"
        mc:Ignorable="d"
        Title="Monia" Height="450" Width="800">
    <Grid Background="#202020">
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Image x:Name="WallpaperImage"
           Grid.Row="0"
           Source="Assets/DefaultWallpaper.png"
           Stretch="Uniform" />

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="12">
        <TextBlock x:Name="RendererStatus"
               Text="3Dは停止中"
               Foreground="White"
               VerticalAlignment="Center"
               Margin="0,0,12,0" />

        <Button Content="画像を選ぶ"
                Padding="12,6"
                Click="ChooseImage_Click" />

        <Button x:Name="StartRendererButton"
                Content="3Dを起動"
                Margin="8,0,0,0"
                Padding="12,6"
                Click="StartRenderer_Click" />

        <Button x:Name="StopRendererButton"
                Content="3Dを終了"
                Margin="8,0,0,0"
                Padding="12,6"
                IsEnabled="False"
                Click="StopRenderer_Click" />
    </StackPanel>
    <StackPanel Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="12,0,12,12">
    <TextBlock x:Name="ExpressionStatus"
               Foreground="White"
               VerticalAlignment="Center"
               Margin="0,0,12,0" />

    <Button x:Name="SmileButton"
            Content="笑顔にする"
            Padding="12,6"
            Click="Smile_Click" />

    <Button x:Name="ResetSmileButton"
            Content="笑顔を解除"
            Margin="8,0,0,0"
            Padding="12,6"
            Click="ResetSmile_Click" />
</StackPanel>
</Grid>
</Window>
